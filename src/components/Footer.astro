---
interface Props {
  phone?: string;
  address?: string;
  facebookUrl?: string;
  mapsUrl?: string;
}

const {
  phone = '0919-782-6430',
  address = 'Brgy. Tomolin, Ligao City, Albay, Philippines',
  facebookUrl = 'https://www.facebook.com/profile.php?id=100057213410203',
  mapsUrl = 'https://maps.app.goo.gl/1mXPt78aRWwsdsex7',
} = Astro.props;

const telHref = `tel:+63${phone.replace(/^0/, '').replace(/-/g, '')}`;
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10">
      <!-- Brand -->
      <div class="sm:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-full flex flex-col items-center justify-center shadow-lg flex-shrink-0" style="background:var(--brand)">
            <span class="text-white font-black text-base leading-none">559</span>
          </div>
          <div>
            <p class="text-white font-bold text-base leading-tight">559 Apartelle</p>
            <p class="text-gray-400 text-xs">Tomolin, Ligao City</p>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed">
          Affordable, comfortable lodging with private garages in the heart of Ligao City, Albay.
        </p>
        <div class="flex items-center gap-3 mt-5">
          <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-colors hover-brand-bg" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href={telHref} class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-colors hover-brand-bg" aria-label="Call us">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
          </a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-colors hover-brand-bg" aria-label="Maps">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-widest mb-4">Quick Links</h4>
        <ul class="space-y-2">
          {[
            { href: '#home', label: 'Home' },
            { href: '#rooms', label: 'Rooms & Units' },
            { href: '#amenities', label: 'Amenities' },
            { href: '#gallery', label: 'Gallery' },
            { href: '#contact', label: 'Contact & Location' },
          ].map(link => (
            <li><a href={link.href} class="text-gray-400 text-sm transition-colors footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-widest mb-4">Contact</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color:var(--brand)">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            <span class="text-gray-400 text-sm">{address}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color:var(--brand)">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            <a href={telHref} class="text-gray-400 text-sm transition-colors footer-link">{phone}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500">
      <p>© {year} Ligao 559 Apartelle. All rights reserved.</p>
      <p>{address}</p>
    </div>
  </div>
</footer>

<style>
  .hover-brand-bg:hover { background: var(--brand) !important; }
  .footer-link:hover { color: var(--brand) !important; }
</style>
