---
interface Props {
  phone?: string;
}
const { phone = '0919-782-6430' } = Astro.props;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent"
  style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 100%);"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="#home" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform" style="background:var(--brand)">
          <span class="text-white font-black text-sm leading-none">559</span>
        </div>
        <div class="hidden sm:block">
          <p class="logo-name text-white font-bold text-base leading-tight drop-shadow-md">559 Apartelle</p>
          <p class="logo-sub text-white/80 text-xs leading-tight drop-shadow">Tomolin, Ligao City</p>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-6">
        {[
          { href: '#home', label: 'Home' },
          { href: '#rooms', label: 'Rooms' },
          { href: '#amenities', label: 'Amenities' },
          { href: '#gallery', label: 'Gallery' },
          { href: '#contact', label: 'Contact' },
        ].map(link => (
          <a href={link.href} class="text-white/90 hover:text-white text-sm font-medium transition-colors drop-shadow">
            {link.label}
          </a>
        ))}
        <a
          href={`tel:+63${phone.replace(/^0/, '').replace(/-/g, '')}`}
          class="book-btn ml-2 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors shadow-lg"
          style="background:var(--brand)"
        >
          Book Now
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2 rounded-lg hover:bg-white/10 transition-colors" aria-label="Toggle menu">
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white shadow-xl border-t border-gray-100">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1">
      {[
        { href: '#home', label: 'Home' },
        { href: '#rooms', label: 'Rooms' },
        { href: '#amenities', label: 'Amenities' },
        { href: '#gallery', label: 'Gallery' },
        { href: '#contact', label: 'Contact' },
      ].map(link => (
        <a href={link.href} class="mobile-nav-link text-gray-700 font-medium py-3 border-b border-gray-100 transition-colors" style="--tw-text-opacity:1">
          {link.label}
        </a>
      ))}
      <a
        href={`tel:+63${phone.replace(/^0/, '').replace(/-/g, '')}`}
        class="mt-3 text-white font-semibold py-3 rounded-full text-center transition-colors"
        style="background:var(--brand)"
      >
        <span class="ms mr-1" style="font-size:1rem">call</span> Book Now
      </a>
    </nav>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar')!;
  const mobileMenuBtn = document.getElementById('mobile-menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const menuIcon = document.getElementById('menu-icon')!;
  const closeIcon = document.getElementById('close-icon')!;

  function setScrolledState(scrolled: boolean) {
    if (scrolled) {
      navbar.classList.remove('bg-transparent');
      navbar.classList.add('bg-white', 'shadow-lg');
      navbar.style.backgroundImage = 'none';
      navbar.querySelectorAll<HTMLElement>('nav a:not(.book-btn)').forEach(a => { a.style.color = '#374151'; });
      (navbar.querySelector('.logo-name') as HTMLElement | null)?.style.setProperty('color', '#1f2937');
      (navbar.querySelector('.logo-sub') as HTMLElement | null)?.style.setProperty('color', '#6b7280');
      (navbar.querySelector('#mobile-menu-btn') as HTMLElement | null)?.style.setProperty('color', '#1f2937');
    } else {
      navbar.classList.remove('bg-white', 'shadow-lg');
      navbar.classList.add('bg-transparent');
      navbar.style.backgroundImage = 'linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 100%)';
      navbar.querySelectorAll<HTMLElement>('nav a:not(.book-btn)').forEach(a => { a.style.color = ''; });
      (navbar.querySelector('.logo-name') as HTMLElement | null)?.style.setProperty('color', '');
      (navbar.querySelector('.logo-sub') as HTMLElement | null)?.style.setProperty('color', '');
      (navbar.querySelector('#mobile-menu-btn') as HTMLElement | null)?.style.setProperty('color', '');
    }
  }

  window.addEventListener('scroll', () => setScrolledState(window.scrollY > 50), { passive: true });

  mobileMenuBtn.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    menuIcon.classList.toggle('hidden', !isOpen ? false : true);
    closeIcon.classList.toggle('hidden', !isOpen ? true : false);
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    });
  });
</script>
