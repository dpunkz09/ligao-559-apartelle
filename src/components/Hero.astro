---
interface Props {
  badge?: string;
  headline?: string;
  subheadline?: string;
  bgImage?: string;
  phone?: string;
}

const {
  badge = 'Now Accepting Guests · Ligao City, Albay',
  headline = 'Nice & Relax',
  subheadline = 'Comfortable, affordable rooms with private garages in the heart of Tomolin, Ligao City. Perfect for families, travelers, and long-stay guests.',
  bgImage = '/images/entrance.jpg',
  phone = '0919-782-6430',
} = Astro.props;

const telHref = `tel:+63${phone.replace(/^0/, '').replace(/-/g, '')}`;
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <img
      src={bgImage}
      alt="Front entrance of 559 Apartelle in Tomolin, Ligao City, Albay"
      class="w-full h-full object-cover"
      fetchpriority="high"
      width="1920"
      height="1080"
      onerror={`this.onerror=null;this.src=this.src.replace('.jpg','.svg');`}
    />
    <div class="absolute inset-0 bg-gradient-to-br from-black/70 via-black/50 to-black/40"></div>
  </div>

  <!-- Decorative blobs -->
  <div class="absolute top-1/4 right-1/4 w-64 h-64 rounded-full blur-3xl pointer-events-none opacity-20" style="background:var(--brand)"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 border border-white/30 backdrop-blur-sm text-white text-sm font-medium px-4 py-1.5 rounded-full mb-6" style="background:color-mix(in srgb, var(--brand) 20%, transparent)">
      <span class="w-2 h-2 rounded-full animate-pulse" style="background:var(--brand)"></span>
      {badge}
    </div>

    <!-- Logo -->
    <div class="w-24 h-24 sm:w-32 sm:h-32 mx-auto mb-6 rounded-full flex flex-col items-center justify-center shadow-2xl border-4 border-white/30" style="background:var(--brand)">
      <span class="text-white font-black text-3xl sm:text-4xl leading-none">559</span>
      <span class="text-white/90 font-semibold text-xs sm:text-sm tracking-widest uppercase mt-1">Apartelle</span>
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white leading-tight mb-4 drop-shadow-lg">
      {headline.split(' ').map((word, i, arr) => (
        i === arr.length - 1
          ? <span style="color:var(--brand)">{word}</span>
          : <>{word}{' '}</>
      ))}
    </h1>

    <p class="text-lg sm:text-xl text-white/80 max-w-xl mx-auto mb-8 leading-relaxed">{subheadline}</p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={telHref}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-white font-bold px-8 py-4 rounded-full text-lg transition-all shadow-xl hover:-translate-y-0.5"
        style="background:var(--brand)"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
        </svg>
        Call to Book
      </a>
      <a href="#rooms" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 text-white font-semibold px-8 py-4 rounded-full text-lg transition-all">
        View Rooms
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-12 grid grid-cols-3 gap-4 max-w-sm mx-auto">
      {[{ value: '24/7', label: 'Open' }, { value: '₱', label: 'Affordable' }, { value: 'lock', label: 'Secure' }].map(stat => (
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl py-3 px-2 text-center">
          <div class="text-2xl font-black text-white">
            {stat.value === 'lock'
              ? <span class="ms" style="font-size:1.5rem">{stat.value}</span>
              : stat.value}
          </div>
          <div class="text-xs text-white/70 mt-0.5">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 animate-bounce">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
