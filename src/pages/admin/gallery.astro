---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/auth';
import { getDb, getGallery } from '../../lib/db';

if (!isAuthenticated(Astro.cookies)) return Astro.redirect('/admin/login');

const photos = getGallery(getDb());
---

<AdminLayout title="Gallery" active="Gallery">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-gray-900">Gallery</h1>
      <p class="text-gray-500 text-sm mt-1">Upload photos, set the featured image, and remove old ones.</p>
    </div>
    <button id="upload-btn" class="btn-primary flex items-center gap-2 self-start">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Upload Photo
    </button>
  </div>

  <!-- Upload form (hidden) -->
  <div id="upload-panel" class="hidden bg-white rounded-2xl p-6 shadow-sm border border-gray-100 mb-6">
    <h3 class="font-bold text-gray-900 mb-4">Add New Photo</h3>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="field-label">Photo File</label>
        <input type="file" id="file-input" accept="image/*" class="field-input cursor-pointer" />
        <div id="file-preview-wrap" class="hidden mt-3">
          <img id="file-preview" src="" alt="Preview" class="h-32 rounded-xl object-cover" />
        </div>
      </div>
      <div class="space-y-4">
        <label class="block">
          <span class="field-label">Alt Text</span>
          <input type="text" id="new-alt" placeholder="e.g. Room with TV" class="field-input" />
        </label>
        <label class="block">
          <span class="field-label">Caption</span>
          <input type="text" id="new-caption" placeholder="e.g. Spacious Living Area" class="field-input" />
        </label>
        <label class="flex items-center gap-2 cursor-pointer mt-1">
          <input type="checkbox" id="new-featured" class="w-4 h-4 rounded" style="accent-color:var(--brand)" />
          <span class="text-sm font-medium text-gray-700">Set as featured (large) photo</span>
        </label>
      </div>
    </div>
    <div class="flex gap-3 mt-5">
      <button id="upload-submit" class="btn-primary">Upload Photo</button>
      <button id="upload-cancel" class="btn-secondary">Cancel</button>
    </div>
    <div id="upload-error" class="hidden mt-3 text-sm text-red-500"></div>
  </div>

  <!-- Photos grid -->
  <div id="photos-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4">
    {photos.map(photo => (
      <div class="photo-card bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 group" data-id={photo.id}>
        <div class="relative h-40 bg-gray-100">
          <img
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover"
            onerror={`this.onerror=null;this.src=this.src.replace('.jpg','.svg');`}
          />
          {photo.is_featured === 1 && (
            <div class="absolute top-2 left-2 text-white text-xs font-bold px-2 py-0.5 rounded-full shadow" style="background:var(--brand)">
              ★ Featured
            </div>
          )}
        </div>
        <div class="p-3">
          <p class="text-xs font-semibold text-gray-700 truncate">{photo.caption || photo.alt || photo.src}</p>
          <p class="text-xs text-gray-400 truncate">{photo.src}</p>
          <div class="flex items-center gap-2 mt-2">
            <button
              class="set-featured-btn text-xs px-2 py-1 rounded-lg border transition-colors"
              style={photo.is_featured ? 'border-color:var(--brand);color:var(--brand)' : 'border-color:#e5e7eb;color:#6b7280'}
              data-id={photo.id}
            >
              {photo.is_featured ? '★ Featured' : 'Set Featured'}
            </button>
            <button class="delete-btn ml-auto text-xs px-2 py-1 rounded-lg border border-red-200 text-red-500 hover:bg-red-50 transition-colors" data-id={photo.id} data-src={photo.src}>
              Delete
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>

  {photos.length === 0 && (
    <div class="text-center py-16 text-gray-400">
      <span class="ms text-6xl mb-3 block" style="color:#d1d5db">photo_library</span>
      <p class="font-semibold">No photos yet. Upload your first one!</p>
    </div>
  )}
</AdminLayout>

<style>
  .field-label { font-size: 0.8125rem; font-weight: 600; color: #4b5563; display: block; margin-bottom: 0.375rem; }
  .field-input { width: 100%; padding: 0.625rem 0.875rem; border: 1.5px solid #e5e7eb; border-radius: 0.625rem; font-size: 0.875rem; font-family: inherit; outline: none; transition: border-color 0.15s; background: #f9fafb; color: #111827; display: block; }
  .field-input:focus { border-color: var(--brand); background: white; }
  .btn-primary { background: var(--brand); color: white; font-weight: 700; border: none; border-radius: 0.75rem; cursor: pointer; font-family: inherit; font-size: 0.875rem; padding: 0.625rem 1.25rem; transition: background 0.15s; }
  .btn-primary:hover { background: var(--brand-dark); }
  .btn-secondary { background: #f3f4f6; color: #374151; font-weight: 600; border: 1.5px solid #e5e7eb; border-radius: 0.625rem; cursor: pointer; font-family: inherit; font-size: 0.875rem; padding: 0.625rem 1rem; transition: all 0.15s; }
  .btn-secondary:hover { border-color: var(--brand); color: var(--brand); }
</style>

<script>
  const uploadBtn = document.getElementById('upload-btn')!;
  const uploadPanel = document.getElementById('upload-panel')!;
  const uploadCancel = document.getElementById('upload-cancel')!;
  const uploadSubmit = document.getElementById('upload-submit') as HTMLButtonElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const filePreview = document.getElementById('file-preview') as HTMLImageElement;
  const filePreviewWrap = document.getElementById('file-preview-wrap')!;
  const uploadError = document.getElementById('upload-error')!;

  uploadBtn.addEventListener('click', () => uploadPanel.classList.toggle('hidden'));
  uploadCancel.addEventListener('click', () => uploadPanel.classList.add('hidden'));

  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (f) {
      // Revoke the previous blob URL to avoid memory leaks
      if (filePreview.src.startsWith('blob:')) URL.revokeObjectURL(filePreview.src);
      filePreview.src = URL.createObjectURL(f);
      filePreviewWrap.classList.remove('hidden');
    }
  });

  uploadSubmit.addEventListener('click', async () => {
    const file = fileInput.files?.[0];
    if (!file) { uploadError.textContent = 'Please select a file.'; uploadError.classList.remove('hidden'); return; }

    uploadError.classList.add('hidden');
    uploadSubmit.textContent = 'Uploading…';
    uploadSubmit.disabled = true;

    const fd = new FormData();
    fd.append('file', file);
    fd.append('alt', (document.getElementById('new-alt') as HTMLInputElement).value);
    fd.append('caption', (document.getElementById('new-caption') as HTMLInputElement).value);
    fd.append('is_featured', (document.getElementById('new-featured') as HTMLInputElement).checked ? '1' : '0');

    const res = await fetch('/api/admin/gallery', { method: 'POST', body: fd });
    if (res.ok) {
      window.location.reload();
    } else {
      const d = await res.json();
      uploadError.textContent = d.error || 'Upload failed.';
      uploadError.classList.remove('hidden');
      uploadSubmit.textContent = 'Upload Photo';
      uploadSubmit.disabled = false;
    }
  });

  // Set featured
  document.querySelectorAll<HTMLButtonElement>('.set-featured-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = Number(btn.dataset.id);
      await fetch('/api/admin/gallery', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, is_featured: 1 }),
      });
      window.location.reload();
    });
  });

  // Delete
  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this photo? This cannot be undone.')) return;
      const id = Number(btn.dataset.id);
      await fetch('/api/admin/gallery', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      btn.closest('.photo-card')?.remove();
    });
  });
</script>
