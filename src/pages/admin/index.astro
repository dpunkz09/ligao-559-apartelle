---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/auth';
import { getDb, getSettings, getRooms, getAmenities, getGallery } from '../../lib/db';

if (!isAuthenticated(Astro.cookies)) return Astro.redirect('/admin/login');

const db = getDb();
const s = getSettings(db);
const rooms = getRooms(db);
const amenities = getAmenities(db);
const photos = getGallery(db);
---

<AdminLayout title="Dashboard" active="Dashboard">
  <div class="mb-8">
    <h1 class="text-2xl font-black text-gray-900">Dashboard</h1>
    <p class="text-gray-500 text-sm mt-1">Welcome back. Here's an overview of your site content.</p>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    {[
      { label: 'Rooms', value: rooms.length, icon: 'bed', href: '/admin/rooms' },
      { label: 'Amenities', value: amenities.length, icon: 'auto_awesome', href: '/admin/amenities' },
      { label: 'Gallery Photos', value: photos.length, icon: 'photo_library', href: '/admin/gallery' },
      { label: 'Brand Color', value: s.brand_color, icon: 'palette', href: '/admin/settings', isColor: true },
    ].map(card => (
      <a href={card.href} class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow block">
        <span class="ms text-3xl mb-2 block" style="color:var(--brand)">{card.icon}</span>
        {card.isColor ? (
          <div class="flex items-center gap-2 mb-0.5">
            <div class="w-6 h-6 rounded-full border border-gray-200 flex-shrink-0" style={`background:${card.value}`}></div>
            <div class="text-sm font-black text-gray-900 font-mono truncate">{card.value}</div>
          </div>
        ) : (
          <div class="text-2xl font-black text-gray-900">{card.value}</div>
        )}
        <div class="text-xs text-gray-500 mt-0.5">{card.label}</div>
      </a>
    ))}
  </div>

  <!-- Quick actions -->
  <h2 class="text-base font-bold text-gray-700 mb-4">Quick Actions</h2>
  <div class="grid sm:grid-cols-2 gap-4">
    {[
      { href: '/admin/settings', title: 'Edit Site Settings', desc: 'Change hero text, tagline, phone, address, theme color.', icon: 'settings' },
      { href: '/admin/gallery', title: 'Manage Gallery', desc: 'Upload photos, set featured image, reorder or delete.', icon: 'photo_library' },
      { href: '/admin/rooms', title: 'Edit Rooms', desc: 'Update room names, descriptions, images and features.', icon: 'bed' },
      { href: '/admin/amenities', title: 'Edit Amenities', desc: 'Add, edit or remove amenity tiles shown on the homepage.', icon: 'auto_awesome' },
    ].map(item => (
      <a href={item.href} class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all flex items-start gap-4">
        <span class="ms text-[28px] flex-shrink-0 mt-0.5" style="color:var(--brand)">{item.icon}</span>
        <div>
          <p class="font-bold text-gray-900 text-sm">{item.title}</p>
          <p class="text-gray-500 text-xs mt-0.5 leading-relaxed">{item.desc}</p>
        </div>
      </a>
    ))}
  </div>

  <!-- Current site info preview -->
  <div class="mt-8 bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
    <h2 class="font-bold text-gray-900 mb-4 text-sm uppercase tracking-widest">Current Site Info</h2>
    <div class="space-y-3 text-sm">
      <div class="flex gap-3"><span class="text-gray-400 w-32 flex-shrink-0">Phone</span><span class="font-medium">{s.phone}</span></div>
      <div class="flex gap-3"><span class="text-gray-400 w-32 flex-shrink-0">Address</span><span class="font-medium">{s.address}</span></div>
      <div class="flex gap-3"><span class="text-gray-400 w-32 flex-shrink-0">Headline</span><span class="font-medium">{s.hero_headline}</span></div>
      <div class="flex items-center gap-3">
        <span class="text-gray-400 w-32 flex-shrink-0">Brand Color</span>
        <div class="flex items-center gap-2">
          <div class="w-5 h-5 rounded-full border border-gray-200" style={`background:${s.brand_color}`}></div>
          <span class="font-medium font-mono text-xs">{s.brand_color}</span>
        </div>
      </div>
    </div>
    <a href="/admin/settings" class="mt-4 inline-flex text-xs font-semibold transition-colors" style="color:var(--brand)">Edit Settings →</a>
  </div>
</AdminLayout>
